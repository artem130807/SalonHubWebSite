generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Client
  SalonAdmin
  Master
}

enum AppointmentStatus {
  Confirmed
  Completed
  Cancelled
}

enum TimeSlotStatus {
  Available
  Booked
  Cancelled
}

enum InboxMessageType {
  CreationAppointment
  CompletedAppointment
  Reminder
  Promotion
  CancelledAppointment
}

enum MessageAudience {
  User
  Admin
  Master
}

enum StatsJobStatus {
  Running
  Completed
  Failed
}

model User {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  email          String    @unique
  phone          String
  passwordHash   String
  role           UserRole
  emailVerified  Boolean   @default(false)
  city           String?
  createdAt      DateTime  @default(now())
  salonAdmins    SalonAdmin[]
  masterProfiles MasterProfile[]
  appointments   Appointment[] @relation("ClientAppointments")
  refreshTokens  RefreshToken[]
  inbox          InboxMessage[]
  reviews        Review[]
  subscriptions  MasterSubscription[]
  conversationsA Conversation[] @relation("ConversationA")
  conversationsB Conversation[] @relation("ConversationB")
  chatMessages   ChatMessage[]
}

model EmailVerification {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  codeHash  String
  createdAt DateTime @default(now())
  expiresAt DateTime
  isUsed    Boolean  @default(false)

  @@index([email, isUsed])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Salon {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  city         String
  street       String
  building     String
  phone        String?
  openingTime  String?
  closingTime  String?
  isActive     Boolean         @default(true)
  rating       Decimal         @default(0) @db.Decimal(4, 2)
  ratingCount  Int             @default(0)
  createdAt    DateTime        @default(now())
  admins       SalonAdmin[]
  masters      MasterProfile[]
  services     Service[]
  appointments Appointment[]
  photos       SalonPhoto[]
  reviews      Review[]
  dailyStats   DailySalonStat[]
}

model SalonAdmin {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @unique @db.Uuid
  salonId String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model SalonPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  salonId   String   @db.Uuid
  url       String
  createdAt DateTime @default(now())
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model MasterProfile {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @unique @db.Uuid
  salonId         String          @db.Uuid
  bio             String?
  specialization  String?
  avatarUrl       String?
  rating          Decimal         @default(0) @db.Decimal(4, 2)
  ratingCount     Int             @default(0)
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  salon           Salon           @relation(fields: [salonId], references: [id], onDelete: Restrict)
  timeSlots       MasterTimeSlot[]
  offeredServices MasterService[]
  appointments    Appointment[]
  templates       WeeklyTemplate[]
  subscribers     MasterSubscription[]
  reviews         Review[]
  dailyStats      DailyMasterStat[]
}

model Service {
  id              String          @id @default(uuid()) @db.Uuid
  salonId         String          @db.Uuid
  name            String
  description     String?
  durationMinutes Int
  price           Decimal         @db.Decimal(10, 2)
  isActive        Boolean         @default(true)
  photoUrl        String?
  salon           Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  masterServices  MasterService[]
  appointments    Appointment[]
}

model MasterService {
  id              String        @id @default(uuid()) @db.Uuid
  masterProfileId String        @db.Uuid
  serviceId       String        @db.Uuid
  master          MasterProfile @relation(fields: [masterProfileId], references: [id], onDelete: Cascade)
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([masterProfileId, serviceId])
}

model MasterTimeSlot {
  id           String         @id @default(uuid()) @db.Uuid
  masterId     String         @db.Uuid
  scheduleDate DateTime       @db.Date
  startTime    String
  endTime      String
  status       TimeSlotStatus @default(Available)
  master       MasterProfile  @relation(fields: [masterId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([masterId, scheduleDate])
}

model WeeklyTemplate {
  id        String        @id @default(uuid()) @db.Uuid
  masterId  String        @db.Uuid
  name      String
  createdAt DateTime      @default(now())
  master    MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)
  days      TemplateDay[]
}

model TemplateDay {
  id          String         @id @default(uuid()) @db.Uuid
  templateId  String         @db.Uuid
  weekday     Int
  startTime   String
  endTime     String
  template    WeeklyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, weekday])
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  salonId         String            @db.Uuid
  clientId        String?           @db.Uuid
  guestName       String?
  masterId        String            @db.Uuid
  serviceId       String            @db.Uuid
  timeSlotId      String            @db.Uuid
  clientNotes     String?
  status          AppointmentStatus @default(Confirmed)
  startTime       String
  endTime         String
  appointmentDate DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  salon           Salon             @relation(fields: [salonId], references: [id], onDelete: Restrict)
  client          User?             @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Restrict)
  master          MasterProfile     @relation(fields: [masterId], references: [id], onDelete: Restrict)
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  timeSlot        MasterTimeSlot    @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  review          Review?
  inbox           InboxMessage[]

  @@index([masterId, appointmentDate])
}

model Review {
  id             String         @id @default(uuid()) @db.Uuid
  appointmentId  String         @unique @db.Uuid
  clientId       String         @db.Uuid
  salonId        String         @db.Uuid
  masterId       String         @db.Uuid
  salonRating    Int
  masterRating   Int
  comment        String?
  createdAt      DateTime       @default(now())
  appointment    Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client         User           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  salon          Salon          @relation(fields: [salonId], references: [id], onDelete: Restrict)
  master         MasterProfile  @relation(fields: [masterId], references: [id], onDelete: Restrict)
}

model InboxMessage {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  appointmentId  String?          @db.Uuid
  content        String
  type           InboxMessageType
  audience       MessageAudience
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment    Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model MasterSubscription {
  id        String        @id @default(uuid()) @db.Uuid
  clientId  String        @db.Uuid
  masterId  String        @db.Uuid
  createdAt DateTime      @default(now())
  client    User          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  master    MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([clientId, masterId])
}

model Conversation {
  id             String        @id @default(uuid()) @db.Uuid
  participant1Id String        @db.Uuid
  participant2Id String        @db.Uuid
  createdAt      DateTime      @default(now())
  participant1   User          @relation("ConversationA", fields: [participant1Id], references: [id], onDelete: Restrict)
  participant2   User          @relation("ConversationB", fields: [participant2Id], references: [id], onDelete: Restrict)
  messages       ChatMessage[]

  @@unique([participant1Id, participant2Id])
}

model ChatMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  senderId       String       @db.Uuid
  body           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
}

model DailySalonStat {
  id             String   @id @default(uuid()) @db.Uuid
  salonId        String   @db.Uuid
  statDate       DateTime @db.Date
  totalCount     Int
  completedCount Int
  cancelledCount Int
  revenue        Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  salon          Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, statDate])
  @@index([statDate])
}

model DailyMasterStat {
  id             String        @id @default(uuid()) @db.Uuid
  masterId       String        @db.Uuid
  statDate       DateTime      @db.Date
  totalCount     Int
  completedCount Int
  cancelledCount Int
  revenue        Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  master         MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)

  @@unique([masterId, statDate])
  @@index([statDate])
}

model StatsJobRun {
  id          String         @id @default(uuid()) @db.Uuid
  statDate    DateTime       @unique @db.Date
  status      StatsJobStatus
  attempt     Int            @default(1)
  leaseUntil  DateTime
  workerId    String?
  error       String?
  startedAt   DateTime
  completedAt DateTime?
}
